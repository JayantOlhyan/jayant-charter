# Public site origin (used for canonical URLs, sitemap, and Open Graph metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "true" ONLY when ready for public search engine indexing
SITE_INDEXABLE="false"

# Local SQLite database path for durable inquiries (defaults to ./data/jayant-charter.db)
INQUIRY_DB_PATH="./data/jayant-charter.db"

# Server-side owner notification destination (keep unset while contact setup is paused per D02)
# OWNER_NOTIFICATION_WEBHOOK_URL=""
# OWNER_NOTIFICATION_SECRET=""
